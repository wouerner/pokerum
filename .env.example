# Variáveis do Pokerum. Local: copie para .env (não versionado). Coolify: aba Environment Variables.
# Nenhuma é obrigatória; os valores abaixo são os padrões.

# Logs (formato do tracing EnvFilter)
RUST_LOG=info,tower_http=info,sqlx=warn

# 1 = semeia 2 vagas e 4 candidaturas fictícias se o banco estiver vazio
POKERUM_SEED=0

# CORS: vazio = desligado (site e API na mesma origem). "*" libera tudo; ou lista separada por vírgula.
POKERUM_CORS_ORIGINS=

# Fila de avaliações em segundo plano (motores LLM/API)
POKERUM_ENGINE_CONCURRENCY=4
POKERUM_QUEUE_POLL_SECS=15

# Definidas pela imagem; só mude se souber o que está fazendo
# PORT=8080
# DATABASE_URL=sqlite:///data/pokerum.db?mode=rwc
# POKERUM_WEB_DIST=/app/web/dist

# Segredos de motores futuros (ex.: API key de LLM) entram aqui E no docker-compose.coolify.yml,
# nunca em scoring_engines.config_json.
